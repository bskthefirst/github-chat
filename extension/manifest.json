{
  "manifest_version": 3,
  "name": "GitHub Chat",
  "version": "1.0.0",
  "description": "Chat with repository owners directly on GitHub. Ask questions and discuss instead of just creating issues.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "chat.html",
        "chat.css",
        "chat.js",
        "icons/*"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}